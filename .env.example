# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Marv AI (Google Gemini, free tier only) ---
# Create a key at https://aistudio.google.com/apikey  (do NOT enable billing)
GEMINI_API_KEY=
# Must be one of the allowlisted free-tier models in src/lib/gemini.ts
GEMINI_MODEL=gemini-3.5-flash-lite
# Safety cap on AI calls per server instance per day (fallback takes over after this)
CHAT_DAILY_AI_LIMIT=200

# --- Email (contact + referral forms). Any SMTP works; Gmail needs an App Password ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=adeniyimarv@gmail.com
MAIL_FROM=
