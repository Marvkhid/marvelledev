[TEMPLATE]
# --- Site ---
NEXT_PUBLIC_SITE_URL=https://marvelledev.vercel.app

# --- Email (contact form). Any SMTP works; Gmail needs an App Password ---
# Every submission is delivered to MAIL_TO (defaults to adeniyimarv@gmail.com).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=adeniyimarv@gmail.com
MAIL_FROM=

# Optional second transport (no SMTP needed): Resend accepts mail for the
# account owner only until a domain is verified, so the sender copy is skipped.
RESEND_API_KEY=
